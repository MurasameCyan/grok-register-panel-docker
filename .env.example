# Entirely optional -- `docker compose up -d` works with no .env at all. Copy to
# .env (chmod 600) only to override a default below.
#
# Read by docker compose on the HOST for variable substitution -- it is NOT
# mounted into the container, and must not be: upstream has no dotenv
# dependency, everything goes through os.environ, and compose already injects
# these as real environment variables.
#
# Every line here is commented out at the value docker-compose.yml already
# defaults to, so uncommenting one without editing it changes nothing. Changing
# a value needs `docker compose up -d` (recreates the container), not `restart`.

# ---------------------------------------------------------------- panel server
# Leave MONITOR_TOKEN unset and the entrypoint generates one on first start,
# saving it to panel-data/monitor_token (read it with
# `docker compose exec panel cat panel-data/monitor_token`). Set it here to pin
# your own; the entrypoint never overwrites a token you supplied. It is real
# auth, not a placeholder -- an empty token opens every read endpoint.
# openssl rand -hex 32   (hex, not base64: + / = confuse .env parsing)
#MONITOR_TOKEN=
#PANEL_INCLUDE_TAIL=0          # 1 shows the raw log tail card (upstream redacts it)
#MONITOR_CORS_ORIGIN=          # exact origin; upstream ignores "*", empty = same-origin

# ------------------------------------------------------------ run sizing
#GROK_BATCH_IDLE_TIMEOUT=360   # no log output for this long -> rebuild the child (min 60)
#GROK_BATCH_MAX_RESTARTS=8     # give up after this many restarts
#PROXY_NETWORK_COOLDOWN_SECONDS=90     # floored at 10 upstream
#PROXY_RISK_COOLDOWN_SECONDS=1800      # floored at 60 upstream
# The next three are read by upstream but NOT on the path the panel starts:
# concurrency and target count come from log/monitor_control.json, which the
# panel's own "并发数" / "再跑 N 个" fields write. Change those in the UI.
#REGISTER_WORKERS=2            # only run_xvfb_smoke.py reads this
#ORCH_BASE_CPA=0               # overridden by monitor_control.json once the panel writes it
#ORCH_ADD_COUNT=100            # same

# --------------------------------------------------------- browser runtime
#GROK_USE_XVFB=auto            # auto|1|0 only; other values abort at startup
#GROK_PYTHON_BIN=              # overrides .venv/bin/python for spawned workers

# -------------------------------------------------------------- state paths
# All of these are fed to Path(). An empty value resolves to "." -- i.e. inside
# /app/src, which the entrypoint's `git reset --hard` wipes on every start. If
# you set one, use an absolute path under a mounted directory (see the volumes
# in docker-compose.yml). Note config.json points at panel-data/ rather than the
# /app/src symlink: saving from the panel replaces the target via os.replace,
# which would turn the symlink into a real file and lose it on the next start.
#CPA_AUTH_DIR=/app/src/cpa_auth
#EMAIL_PROVIDER_CONFIG_FILE=/app/src/panel-data/config.json
#PROXY_POOL_STATE_FILE=/app/src/log/proxy_pool.json
#PROXY_POOL_LEGACY_FILE=/app/src/panel-data/proxies.txt
#BLACKLIST_STATE_FILE=/app/src/log/blacklist_state.json
#EMAIL_DOMAIN_POOL_STATE_FILE=/app/src/log/email_domain_pool.json
#BATCH_LOG=                    # pin one log file; empty = newest log/batch*.log

# ------------------------------------------------------ email credentials
# These WIN over config.json (upstream reads `os.environ.get(X) or config[x]`),
# so setting one here makes editing that field in the panel UI look broken.
# Prefer the UI / config.json. Anything set here also shows up in
# `docker inspect` and in the shell history of whoever ran compose.
#CLOUDMAIL_URL=
#CLOUDMAIL_ADMIN_EMAIL=
#CLOUDMAIL_PASSWORD=
#MOEMAIL_API_BASE=
#MOEMAIL_API_URL=              # legacy alias, only read if MOEMAIL_API_BASE is empty
#MOEMAIL_API_KEY=

# ----------------------------------------------------------- outbound proxy
# These do NOT proxy registration: run_batch_headless pops the proxy vars before
# starting a worker, so put the registration proxy in config.json ("proxy") or
# the panel's proxy pool. These cover the entrypoint's git/pip and the account
# recovery run. Geo and connectivity probes bypass them on purpose.
#HTTPS_PROXY=
#HTTP_PROXY=
#ALL_PROXY=
#NO_PROXY=

# --------------------------------------------------- this image's own knobs
#UPSTREAM_REF=main             # tag/branch to run instead of upstream main
#UPSTREAM_AUTO_UPDATE=1        # 0 freezes on the revision baked into the image
#AUTO_PIP_INSTALL=1            # 0 skips installing new upstream requirements
#PANEL_FIX_OWNERSHIP=1         # 0 refuses to chown mounts instead of fixing them
#IMAGE_TAG=latest              # or reqs-<sha256> / upstream-<rev> to pin an image
#TZ=Asia/Shanghai
