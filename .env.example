# Copy to .env (chmod 600). Read by docker compose on the HOST for variable
# substitution -- it is NOT mounted into the container, and must not be:
# upstream has no dotenv dependency, everything goes through os.environ, and
# compose already injects these as real environment variables.
# openssl rand -hex 32   (hex, not base64: + / = confuse .env parsing)
MONITOR_TOKEN=replace-me
UPSTREAM_REF=main
UPSTREAM_AUTO_UPDATE=1
IMAGE_TAG=latest
TZ=Asia/Shanghai
