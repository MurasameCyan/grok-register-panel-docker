# Entirely optional -- `docker compose up -d` works with no .env at all. Copy to
# .env (chmod 600) only to override a default below.
#
# Read by docker compose on the HOST for variable substitution -- it is NOT
# mounted into the container, and must not be: upstream has no dotenv
# dependency, everything goes through os.environ, and compose already injects
# these as real environment variables.
#
# Leave MONITOR_TOKEN unset and the entrypoint generates one on first start,
# saving it to panel-data/monitor_token (read it with
# `docker compose exec panel cat panel-data/monitor_token`). Set it here to pin
# your own; the entrypoint never overwrites a token you supplied.
# openssl rand -hex 32   (hex, not base64: + / = confuse .env parsing)
#MONITOR_TOKEN=

# The rest are shown at their compose defaults; uncomment to change one.
#UPSTREAM_REF=main            # tag/branch to run instead of upstream main
#UPSTREAM_AUTO_UPDATE=1       # 0 freezes on the revision baked into the image
#IMAGE_TAG=latest             # or reqs-<sha256> / upstream-<rev> to pin an image
#TZ=Asia/Shanghai
